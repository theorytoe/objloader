with "../objloader.gpr";
with "../config/objloader_config.gpr";

project Objloader_Test is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Objloader_Config.Ada_Compiler_Switches;
   end Compiler;

end Objloader_Test;
